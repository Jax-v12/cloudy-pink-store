generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum StockStatus {
  READY
  LOCKED
  SOLD
}

model Product {
  id             Int            @id @default(autoincrement())
  name           String
  slug           String         @unique
  price          Int
  category       String         @default("Apps Premium")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  stocks         AccountStock[]
  orders         Order[]
}

model AccountStock {
  id              Int         @id @default(autoincrement())
  productId       Int
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  emailAccount    String
  passwordAccount String
  profileName     String?
  pin             String?
  additionalInfo  String?     @db.Text
  status          StockStatus @default(READY)
  fingerprint     String      @unique @default(uuid())
  order           Order?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Order {
  id             Int          @id @default(autoincrement())
  invoice        String       @unique
  accessToken    String       @unique @default(uuid())
  customerEmail  String
  totalAmount    Int
  status         OrderStatus  @default(PENDING)
  paymentMethod  String       @default("QRIS")
  qrisUrl        String?      @db.Text
  expiresAt      DateTime

  productId      Int
  product        Product      @relation(fields: [productId], references: [id])

  accountStockId Int?         @unique
  accountStock   AccountStock? @relation(fields: [accountStockId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AdminSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model RateLimit {
  id        String   @id
  points    Int      @default(0)
  expiresAt DateTime
}